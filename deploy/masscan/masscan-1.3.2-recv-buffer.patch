+            else {
+                /* A libpcap read timeout need not expire on an idle interface.
+                 * Live handles are nonblocking; wait only after buffered packets
+                 * have drained, then let receive_thread recheck is_rx_done. */
+                int fd = PCAP.get_selectable_fd(adapter->pcap);
+                if (fd >= 0) {
+                    struct pollfd ready;
+                    ready.fd = fd;
+                    ready.events = POLLIN;
+                    ready.revents = 0;
+                    if (poll(&ready, 1, 100) < 0 ||
+                            (ready.revents & (POLLERR | POLLHUP | POLLNVAL)))
+                        pixie_usleep(1000);
+                } else {
+                    pixie_usleep(1000);
+                }
+            }
+#endif
