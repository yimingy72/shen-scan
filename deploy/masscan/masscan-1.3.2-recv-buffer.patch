+int rawsock_get_capture_stats(
+    struct Adapter *adapter,
+    unsigned *received,
+    unsigned *dropped,
+    unsigned *interface_dropped)
+{
+    struct pcap_stat stats;
+
+    if (adapter == NULL || adapter->pcap == NULL || adapter->ring)
+        return -1;
+    if (PCAP.stats(adapter->pcap, &stats) != 0)
+        return -1;
+
+    *received = stats.ps_recv;
+    *dropped = stats.ps_drop;
+    *interface_dropped = stats.ps_ifdrop;
