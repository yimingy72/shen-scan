# Local development. Replace these example tokens before exposing the API.
DATABASE_URL=postgres://scanner:change-me@127.0.0.1:15439/scanner?sslmode=disable
POSTGRES_PASSWORD=change-me
SCAN_ADMIN_TOKEN=replace-with-a-random-admin-token
SCAN_JOIN_TOKEN=replace-with-a-different-random-worker-token
SCAN_LISTEN_ADDR=127.0.0.1:8080
SCAN_STATIC_DIR=web/dist
SCAN_DOWNLOAD_DIR=bin/release
SCAN_CLOUD_PROVIDER=manual
SCAN_ALLOW_PRIVATE_TARGETS=false
SCAN_PORT_RATE_PPS=5000
SCAN_PORT_SHARD_MAX=4
# Same-target allowance is shared by all Workers; more Workers do not raise it.
SCAN_TARGET_DISCOVERY_PPS=5000
# Optional measured homogeneous profile. Leave empty before calibration.
SCAN_CALIBRATED_PORT_PROFILE=
SCAN_CALIBRATED_PPS=
SCAN_CALIBRATED_SYN_RATE=
# Worker tools (install Nmap with its data directory and both compiled helpers).
NMAP_BINARY=nmap
WEB_PROBE_BINARY=web-probe-worker
FINGERPRINT_WORKER_BINARY=fingerprint-worker

# Alibaba Cloud provider. Configure credentials only in ignored local environment files.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
SCAN_ALI_REGION=cn-hangzhou
SCAN_ALI_ZONE_ID=cn-hangzhou-h
SCAN_POOL_ID=scan-platform
SCAN_ALI_IMAGE_ID=
SCAN_ALI_INSTANCE_TYPES=
SCAN_ALI_MIN_MEMORY_GIB=2
SCAN_ALI_PUBLIC_BANDWIDTH_MBIT=10
SCAN_ALI_VSWITCH_IDS=
SCAN_ALI_SECURITY_GROUP_ID=
SCAN_CONTROL_PUBLIC_URL=
SCAN_AGENT_PACKAGE_URL=
SCAN_AGENT_PACKAGE_SHA256=
SCAN_CONTROL_CA_FILE=
SCAN_TLS_CERT=
SCAN_TLS_KEY=

# Optional price limit; empty means follow Spot market price.
SCAN_ALI_PRICE_LIMIT=
# Validation fixture must stay false for ordinary deployment.
SCAN_AGENT_VALIDATION_FIXTURE=false
